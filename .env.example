# .env.example — Copy this to .env and adjust values for your environment.
# Do NOT commit .env to version control.

# Path to YOLOv8 license-plate detector weights (.pt file).
# Download instructions: see models/README.md
ALPR_MODEL_PATH=models/plate_detector.pt

# Minimum detector confidence threshold (0.0 – 1.0).
ALPR_DETECT_CONF=0.25

# YOLO inference image size (pixels, must be multiple of 32).
ALPR_INFER_SIZE=640

# Inference device: "cpu" | "cuda" | "cuda:0" | "mps"
ALPR_DEVICE=cpu

# OCR engine: "easyocr"
ALPR_OCR_ENGINE=easyocr

# EasyOCR language codes (comma-separated).
ALPR_EASYOCR_LANGS=en

# Minimum OCR word confidence (0.0 – 1.0).
ALPR_OCR_MIN_CONF=0.1

# Maximum upload size in megabytes.
ALPR_MAX_UPLOAD_MB=10.0

# Pixel padding around cropped plate regions.
ALPR_CROP_PADDING=8

# Strict Indian registration validation (true|false).
ALPR_STRICT_VALIDATION=false

# Enable verbose debug logging (true|false).
ALPR_DEBUG=false
